# Copy to .env for local runs (never commit .env). In GitHub Actions these come from Secrets / Variables.

# ---------------------------------------------------------------- safety
# true  = everything runs but NO email is sent and NO form is submitted ("WOULD SEND/SUBMIT" is logged,
#         drafts are saved to the DB). false = real actions. Keep true until you reviewed dry-run output.
DRY_RUN=true
# Offline demo: fake jobs + fake LLM + no network. Forces DRY_RUN=true. Uses profile/profile.sample.yaml.
FAKE_MODE=false
# Quality over quantity: hard cap on applications created per UTC day
MAX_APPLICATIONS_PER_DAY=15
# Cap on LLM job-matching calls per run (protects free-tier quotas). Cached matches cost 0.
MAX_AI_MATCHES_PER_RUN=30
# Browser (Playwright) apply for Greenhouse/Lever/Ashby. Generic sites are EXPERIMENTAL and off.
ENABLE_BROWSER_APPLY=true
ENABLE_GENERIC_APPLY=false
# Comma separated subset of sources, e.g. greenhouse,lever,remotive (default: config/sources.yaml)
ENABLED_SOURCES=

# ---------------------------------------------------------------- storage
# sqlite (local/dry-run/tests)  |  supabase (GitHub Actions / production)
DB_BACKEND=sqlite
SQLITE_PATH=data/jobagent.sqlite
# Supabase: Project Settings -> API. Use the SERVICE ROLE / secret key (server side only, bypasses RLS).
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------- Telegram
# Create a bot with @BotFather; get your chat id from @userinfobot. Only this chat is ever served.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Only for `python -m jobagent telegram --listen` when the Cloudflare relay webhook is set: the same value as the Worker's
# TELEGRAM_WEBHOOK_SECRET, so the webhook can be put back after the session (Telegram never reveals it). Not needed otherwise.
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------- LLM (any OpenAI-compatible API)
# OpenRouter free tier (default). Key: https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=            # (alias: OPENROUTER_API_KEY)
# Free models with JSON mode (checked against openrouter.ai/api/v1/models on 2026-10-05; the free list changes):
#   nvidia/nemotron-3-super-120b-a12b:free   <- default
#   google/gemma-4-31b-it:free
#   google/gemma-4-26b-a4b-it:free
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Swap provider by env only, e.g. Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#                             Ollama:   LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1  LLM_API_KEY=ollama
LLM_MAX_RETRIES=3
LLM_BACKOFF_SECONDS=2

# ---------------------------------------------------------------- Gmail SMTP (app password, 2FA required)
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------- personal details + resume (ALL OPTIONAL fallbacks)
# Normal way: send your resume PDF to the bot and answer /setup in Telegram. They are stored in Supabase (private
# Storage bucket 'resumes' + the `profile` table) and used by the worker at runtime, even with your laptop off.
# These env values are only used when the database has nothing for that field (DB first, env as fallback).
CANDIDATE_PHONE=
LINKEDIN_URL=
# Locally GITHUB_URL works too; in GitHub Actions the secret must be named CANDIDATE_GITHUB_URL
# (GitHub forbids secret names starting with GITHUB_).
CANDIDATE_GITHUB_URL=
PORTFOLIO_URL=
# Fallback only: base64 of a resume PDF (<= ~35 KB because of GitHub's 48 KB secret limit). Prefer the Telegram upload.
RESUME_PDF_B64=

# ---------------------------------------------------------------- paths (defaults are fine)
PROFILE_PATH=profile/profile.yaml
RESUME_PATH=profile/resume/resume.pdf
ARTIFACTS_DIR=artifacts

# ---------------------------------------------------------------- logging
LOG_LEVEL=INFO
LOG_JSON=0
